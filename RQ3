library(readxl)
library(readr)
library(dplyr)
library(lubridate)
library(forecast)
library(tseries)


############### Australia ###############
#Read data
cpi_data_Australia <- read_excel("dataset_for_prediction.xlsx", sheet = "data_area_Australia") %>%
  select(Value, time)

cpi_data_Australia <- cpi_data_Australia %>%
  mutate(time = ymd(as.character(time)))


cpi_ts_Australia <- ts(cpi_data_Australia$Value, start = c(year(min(cpi_data_Australia$time)), month(min(cpi_data_Australia$time))), frequency = 12)

#Visualization
plot(cpi_ts_Australia, main = "Australia Monthly CPI (Food Index)", ylab = "CPI", xlab = "Year")


fit_ets <- ets(cpi_ts_Australia)
summary(fit_ets)


#Fit ARIMA model (automatically finds the best combination)

d_Australia <- ndiffs(cpi_ts_Australia)    
D_Australia <- nsdiffs(cpi_ts_Australia)   


lambda_Australia <- BoxCox.lambda(cpi_ts_Australia)


model_Australia <- auto.arima(
  cpi_ts_Australia,
  d             = d_Australia,
  D             = D_Australia,
  seasonal      = TRUE,
  lambda        = lambda_Australia,
  biasadj       = TRUE,   
  stepwise      = FALSE,   
  approximation = FALSE    
)

#Check model
summary(model_Australia)
checkresiduals(model_Australia)

#Prediction for the following 12 months
forecast_cpi_Australia <- forecast(model_Australia, h = 12)
plot(forecast_cpi_Australia, main = "Forecasted Australia CPI (Food Index)")

#Check predicted values
forecast_cpi_Australia

predicted_Australia <- data.frame(Date = seq(from = max(cpi_data_Australia$time) + months(1), by = "month", length.out = 12),
                                  Forecast = as.numeric(forecast_cpi_Australia$mean))

